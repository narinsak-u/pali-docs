# Copy to deploy/web.env and replace placeholders. Values stay server-side at runtime.
RAG_BACKEND=langgraph
FASTAPI_BASE_URL=http://api:8000
FASTAPI_INTERNAL_TOKEN=replace-with-random-internal-token
PILOT_TENANT_ID=replace-with-pilot-tenant
PILOT_PRINCIPAL_ID=replace-with-pilot-principal
FASTAPI_IDENTITY_SECRET=replace-with-long-random-secret
# Optional hosted rollback for the existing BFF fallback; these stay server-side.
PROVIDER_NAME=openrouter
OPENROUTER_API_KEY=replace-with-hosted-provider-key
OPENROUTER_LLM_MODEL=replace-with-hosted-model-id
