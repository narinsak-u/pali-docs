# Copy to deploy/api.env and replace placeholders. Never bake these into an image.
PROVIDER_NAME=openrouter
OPENROUTER_API_KEY=replace-with-provider-key
OPENROUTER_LLM_MODEL=replace-with-model-id
PINECONE_API_KEY=replace-with-pinecone-key
PINECONE_INDEX_NAME=replace-with-index-name
PINECONE_CORPUS_REVISION=replace-with-verified-corpus-revision
INTERNAL_API_TOKEN=replace-with-the-same-internal-token
INTERNAL_PRINCIPAL_SECRET=replace-with-the-same-long-random-secret
