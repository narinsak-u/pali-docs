# Copy to deploy/api.env and replace placeholders. Never bake these into an image.
PROVIDER_NAME=local
# Optional hosted-provider rollback values; unused while PROVIDER_NAME=local.
OPENROUTER_API_KEY=replace-with-hosted-provider-key
OPENROUTER_LLM_MODEL=replace-with-hosted-model-id
LOCAL_LLM_BASE_URL=http://vllm:8000/v1
LOCAL_LLM_API_KEY=replace-with-vllm-api-key
LOCAL_LLM_MODEL=Qwen/Qwen3-8B
LOCAL_LLM_TIMEOUT_SECONDS=45
LOCAL_LLM_MAX_OUTPUT_TOKENS=768
# Leave unset until authoritative corpus artifacts are verified.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_CORPUS_REVISION=
INTERNAL_API_TOKEN=replace-with-the-same-internal-token
INTERNAL_PRINCIPAL_SECRET=replace-with-the-same-long-random-secret
PILOT_TENANT_ID=replace-with-pilot-tenant
PILOT_PRINCIPAL_ID=replace-with-pilot-principal
