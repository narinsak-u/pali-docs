# ──────────────────────────────────────────
# Pali Docs — Environment Variables
# ──────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ── Pinecone and RAG retrieval ─────────────
# Required for /api/question. The corpus revision must identify one complete,
# immutable index build published by the external ingestion owner.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_CORPUS_REVISION=

# Optional. Empty selects Pinecone's default namespace (application default: "").
PINECONE_NAMESPACE=

# Retrieval policy values below match the application defaults.
# Integer 1-50; default: 20
RAG_CANDIDATE_TOP_K=20
# Integer 1-12; default: 8
RAG_ACCEPTED_TOP_K=8
# Number 0-1; default: 0
RAG_MIN_SCORE=0
# Integer 1000-50000; default: 12000
RAG_MAX_CONTEXT_CHARS=12000

# ── LLM Provider ───────────────────────────
# Accepted values: "openrouter" or "opencode".
# Unset defaults to "openrouter"; an empty or unknown value is invalid.
PROVIDER_NAME=openrouter

# The selected provider's API key and model ID are required and nonempty.
# Model IDs have no application default.
OPENROUTER_API_KEY=
OPENROUTER_LLM_MODEL=

OPENCODE_API_KEY=
OPENCODE_LLM_MODEL=

# ── RAG evaluation (optional) ──────────────
# Only "ai-sdk" is supported; default: ai-sdk
RAG_EVAL_RUNNER=ai-sdk
# Default: results/rag-evaluation
RAG_EVAL_OUTPUT_DIR=results/rag-evaluation

# ── Algolia (Full-Text Search) ────────────
# Required for the documentation search UI and indexing script.
# Sign up: https://www.algolia.com
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=
# Admin API key — SERVER-SIDE ONLY (used by `bun run index`).
# Must NOT have the NEXT_PUBLIC_ prefix, or it will be inlined into the
# client bundle and exposed to every visitor.
ALGOLIA_ADMIN_API_KEY=
# Optional: for Algolia Assistant / AI search features
NEXT_PUBLIC_ALGOLIA_ASSISTANT_ID=
