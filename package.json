{
  "name": "next-pali-docs-monorepo",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": ["apps/web"],
  "scripts": {
    "dev": "bun --cwd apps/web run dev",
    "build": "bun --cwd apps/web run build",
    "start": "bun --cwd apps/web run start",
    "index": "bun --cwd apps/web run index",
    "test": "bun --cwd apps/web run test",
    "test:run": "bun --cwd apps/web run test:run",
    "eval:rag": "bun --cwd apps/web run eval:rag"
  }
}
