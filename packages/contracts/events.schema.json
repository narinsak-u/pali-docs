{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pali-docs.dev/contracts/events.schema.json",
  "title": "Pali Docs Event Envelope",
  "description": "Versioned, framework-neutral events emitted by a run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "eventId",
    "sequence",
    "eventType",
    "timestamp",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^v[0-9]+$",
      "description": "Version of this event envelope contract."
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "eventType": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
